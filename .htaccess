# Institute for Ageless Living — Medical Weight Loss ad landing page
# Protects the Decoda config / log / cache if they ever sit inside the web root,
# and keeps the lead endpoint out of any cache.

<FilesMatch "^(decoda-config\.php|decoda-leads\.log|decoda-tags\.json|decoda-campaigns\.json|php_errorlog|error_log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  <Files "lead.php">
    Header always set Cache-Control "no-store, no-cache, must-revalidate"
  </Files>
  # Paid-traffic page: keep it out of search results at the header level too.
  <FilesMatch "\.(html|php)$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# Belt and braces: never serve a stray backup/config artifact as plain text.
<FilesMatch "\.(log|bak|orig|sql|env|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
